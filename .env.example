# Subscriber replies; separate from infrastructure accounts and sending domain.
NEWSROOM_CONTACT_EMAIL=workbenchadmin@gmail.com
# Blank uses explicit demo mode. Set live only after service setup.
NEWSROOM_MODE=demo
# Cloud deployment requires Postgres; local runs use durable SQLite in data/.
DATABASE_URL=
# Required for hosted use; generate with npm run setup.
AUTH_SECRET=
ADMIN_PASSWORD=
# Local access is restricted to the loopback interface by npm scripts.
LOCAL_DEMO_ACCESS=true
# Live AI activation is currently deferred: Gateway requires account verification.
NEWSROOM_AI_PAUSED=true
# Optional on Vercel: the function can use its automatically refreshed OIDC identity.
# Local development can use this API key or `vercel env pull` for a temporary OIDC token.
AI_GATEWAY_API_KEY=
# Available low-cost, non-reasoning model checked in the Gateway catalog on 2026-09-09.
NEWSROOM_MODEL=openai/gpt-4.1-mini
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Dedicated receiving address; configure Gmail forwarding separately.
NEWSROOM_INBOUND_ADDRESS=
RESEND_FROM_EMAIL=
# Outbound delivery events use a separate signed webhook from inbound mail.
RESEND_DELIVERY_WEBHOOK_SECRET=
# Canonical website address used by subscriber links and checkout redirects.
NEWSROOM_PUBLIC_URL=http://127.0.0.1:3000
MEMBER_SESSION_SECRET=
# Select a monthly AUD price in /operations; the stored sales switch defaults closed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional owner-only alerts, invoked explicitly in Operations.
NEWSROOM_OWNER_ALERT_EMAIL=
# Optional exact USD per-million input/output model rates for cost estimates.
NEWSROOM_MODEL_PRICES_JSON=
CRON_SECRET=
# No scheduled work until enabled explicitly in Settings.
MONITORING_ENABLED=false
